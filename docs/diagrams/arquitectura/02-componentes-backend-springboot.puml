@startuml TSS_Componentes_Backend
!include ../_estilo.iuml
title TechSupply Solutions — Componentes del backend
top to bottom direction
package "Interfaz HTTP" {
  component "Controladores REST\ny DTO" as API
  component "Autenticación y autorización\nSpring Security" as Security
  component "Validación y errores HTTP" as Errors
}
package "Aplicación" {
  component "Servicios y casos de uso" as Services
}
package "Módulos de negocio" {
  component "Gestión maestra" as Masters
  component "Compras" as Purchases
  component "Inventario" as Inventory
  component "Ventas" as Sales
  component "Contabilidad" as Finance
  component "Recursos humanos" as Payroll
}
package "Servicios compartidos" {
  component "Auditoría" as Audit
  component "Notificaciones" as Notify
  component "Reportería" as Reports
}
package "Infraestructura" {
  component "Repositorios\nSpring Data JPA" as Repos
  component "Migraciones Flyway" as Migrations
  database "PostgreSQL" as DB
}
API ..> Security : requiere permisos
API ..> Errors : valida y responde
API ..> Services : invoca
Services ..> Masters
Services ..> Purchases
Services ..> Inventory
Services ..> Sales
Services ..> Finance
Services ..> Payroll
Services ..> Audit
Services ..> Notify
Reports ..> Repos : lecturas autorizadas
Purchases ..> Inventory : entradas y devoluciones
Sales ..> Inventory : reservas y despachos
Purchases ..> Finance : documentos validados
Sales ..> Finance : documentos validados
Payroll ..> Finance : nómina aprobada
Services ..> Repos
Repos ..> DB : JDBC
Migrations ..> DB : esquema versionado
note bottom of Services
  Los cambios relacionados se confirman o revierten
  en una sola transacción cuando la operación lo requiere.
end note
@enduml
