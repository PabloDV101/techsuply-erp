@startuml TSS_Contexto_Contenedores
!include ../_estilo.iuml
title TechSupply Solutions — Contexto de la solución
left to right direction
actor "Personal interno" as Staff
actor "Cliente" as Customer
node "Navegador web" as Browser {
  component "Aplicación y portal\nReact + TypeScript" as Web
}
node "Servidor de aplicación" as Server {
  component "ERP modular\nSpring Boot / Java 21" as ERP
}
database "PostgreSQL\nDatos del ERP" as DB
cloud "Servicio de correo" as Mail
Staff -- Web : utiliza
Customer -- Web : utiliza portal
Web ..> ERP : REST / JSON
ERP ..> DB : JDBC
ERP ..> Mail : notificaciones
note bottom of ERP
  Monolito modular con seguridad, maestros, compras,
  inventario, ventas, contabilidad, nómina y reportería.
end note
@enduml
