@startuml TSS_Despliegue
!include ../_estilo.iuml
title TechSupply Solutions — Vista de despliegue
top to bottom direction
actor "Usuarios internos y clientes" as Users
node "Navegador" as Browser {
  artifact "Aplicación web" as Client
}
node "Servidor web · zona perimetral" as Edge {
  artifact "Archivos React\ny proxy inverso" as SPA
}
node "Servidor de aplicación · red privada" as App {
  artifact "Backend Spring Boot\nJava 21 / Flyway" as API
}
node "Servidor de datos · red privada" as Data {
  database "PostgreSQL" as DB
}
node "Almacenamiento de respaldo" as Backup {
  artifact "Copias cifradas" as Files
}
cloud "Servicio de correo" as Mail
Users -- Browser
Browser -- Edge : HTTPS
Edge -- App : HTTPS / API
App -- Data : JDBC
App -- Mail : SMTP
Data -- Backup : respaldo
note bottom of Data
  Acceso restringido a los procesos autorizados.
  Las restauraciones se verifican periódicamente.
end note
@enduml
