@startuml ERP_06_Reporteria_Auditoria_Integracion
!include ../_estilo.iuml
 title TechSupply Solutions - Reportería, auditoría e integración
 hide circle

 package "Auditoria e integracion" {
  class EventoAuditoria {
  -id: Long
  -fecha: Instant
  -usuarioId: Long
  -actorTipo: AuditActorType
  -modulo: String
  -accion: String
  -entidad: String
  -entidadId: Long
  -resultado: AuditResult
  -motivoCodigo: String
  -detalle: JSON
}
  class EventoIntegracion {
  -id: Long
  -tipoEvento: String
  -entidadOrigen: String
  -entidadOrigenId: Long
  -claveIdempotencia: String
  -fechaCreacion: DateTime
  -fechaProcesamiento: DateTime
  -estado: EstadoEvento
  -intentos: Integer
  -mensajeError: String
}
 }
 package "Reporteria" {
  class ReportExportController <<implementado>> {
    +exportar(report, format, filters, page): ResponseEntity<byte[]>
  }
  class ReportExportService <<implementado>> {
    +exportar(report, format, filters, page): byte[]
  }
  ReportExportController --> ReportExportService
  ReportExportService --> AuditTrail : REPORT_FILE_GENERATED

  class AnalyticalReportsController <<implementado>> {
    +consultarStockBajo(warehouseId, productId, page)
    +consultarInactividad(asOf, days, warehouseId, page)
    +consultarRotacion(from, to, warehouseId, page)
    +consultarABC(from, to, warehouseId, page)
    +consultarRentabilidad(from, to, customerId, page)
    +consultarMargen(periodId)
  }
  class AnalyticalReportsService <<implementado>> {
    +consultar(criteria): Page<ReportRow>
  }
  class ReportingPoliciesService <<implementado>> {
    +configurarMinimo(productId, warehouseId, minimum)
    +clasificarCuenta(accountId, classification, from, to)
    +anularClasificacion(id, reason)
  }
  AnalyticalReportsController --> AnalyticalReportsService
  AnalyticalReportsController --> ReportingPoliciesService

  class DashboardCsvController <<implementado>> {
    +exportar(from, to, periodId): ResponseEntity<byte[]>
  }
  class DashboardCsvService <<implementado>> {
    +exportar(from, to, periodId): byte[]
  }
  interface AuditTrail <<implementado>>
  DashboardCsvController --> DashboardCsvService
  DashboardCsvService --> DashboardService
  DashboardCsvService --> AuditTrail : DASHBOARD_CSV_GENERATED

  class DashboardController <<implementado>> {
    +consultar(from, to, periodId): DashboardResponse
  }
  class DashboardService <<implementado>> {
    +consultar(from, to, periodId): DashboardResponse
  }
  class DashboardResponse <<implementado>> {
    +from: LocalDate
    +to: LocalDate
    +indicators: List<IndicadorDashboardResponse>
  }
  class IndicadorDashboardResponse <<implementado>> {
    +code: IndicadorDashboard
    +source: String
    +from: LocalDate?
    +to: LocalDate?
    +asOf: Instant?
    +availability: String
    +value: BigDecimal?
    +unit: String
    +unavailabilityReason: String?
  }
  class PrepararDashboardService <<implementado>> {
    +preparar(from, to, periodId): CriteriosDashboard
  }
  class FacturacionProveedorReportController <<implementado>> {
    +consultar(from, to)
  }
  class FacturacionProveedorReportService <<implementado>> {
    +consultar(from, to): FacturacionProveedorReportResponse
  }
  class FacturacionProveedorReportResponse <<implementado>> {
    +from: LocalDate
    +to: LocalDate
    +subtotal: BigDecimal
  }
  class FacturacionVentaReportController <<implementado>> {
    +consultar(from, to)
  }
  class FacturacionVentaReportService <<implementado>> {
    +consultar(from, to): FacturacionVentaReportResponse
  }
  class FacturacionVentaReportResponse <<implementado>> {
    +from: LocalDate
    +to: LocalDate
    +subtotal: BigDecimal
  }
  class CriteriosDashboard <<implementado>> {
    +from: LocalDate
    +to: LocalDate
    +periodId: Long?
    +indicadores: Set<IndicadorDashboard>
  }
  enum IndicadorDashboard <<implementado>> {
    COMPRAS_FACTURADO_SIN_IMPUESTOS
    VENTAS_FACTURADO_SIN_IMPUESTOS
    INVENTARIO_PRODUCTOS_ALERTA
    FINANZAS_RESULTADO
  }
  class "Criterios por reporte (DTO)" as ReportCriteria {
    -periodo: DateRange
    -filtros: criterios validados
    -pagina: Pageable
  }
  class "Resultado por reporte (DTO)" as ReportResult {
    -fuente: String
    -periodo: DateRange
    -disponibilidad: DISPONIBLE | NO_DISPONIBLE
    -filas: proyecciones
  }
  class "Servicio de consulta por reporte" as ReportQueryService {
    +consultar(criteria): ReportResult
  }
  class DefinicionReporte {
  -id: Long
  -codigo: String
  -nombre: String
  -descripcion: String
  -modulo: String
  -consultaClave: String
  -permisoRequerido: String
  -activo: Boolean
}
  class EjecucionReporte {
  -id: Long
  -fechaHora: DateTime
  -parametros: JSON
  -formato: FormatoReporte
  -estado: EstadoReporte
  -filasGeneradas: Long
  -duracionMs: Long
}
  class Indicador {
  -id: Long
  -codigo: String
  -nombre: String
  -descripcion: String
  -unidad: String
  -formula: String
  -fuenteDatos: String
  -frecuenciaActualizacion: String
  -activo: Boolean
}
  class "InternalNotification" as Notificacion {
    -id: Long
    -usuarioId: Long
    -tipoEvento: NotificationType
    -modulo: String
    -entidad: String
    -entidadId: Long
    -claveOperacion: String
    -canal: String
    -asunto: String
    -cuerpo: String
    -estado: NotificationStatus
    -creadaEn: Instant
    -leidaEn: Instant
  }
  class ParametroSistema {
    -id: Long
    -modulo: String
    -clave: String
    -valor: String
    -actualizadoEn: DateTime
  }
  class ValorIndicador {
  -id: Long
  -fechaCalculo: DateTime
  -periodoInicio: Date
  -periodoFin: Date
  -valor: Decimal
}
 }
 package "Inventario" {
  class ResumenAlertaStockController <<implementado>> {
    +consultar(): ResumenAlertaStockResponse
  }
  class AlertaStockService <<implementado>> {
    +listar(page, size, productoId)
    +resumir(): ResumenAlertaStockResponse
  }
  class AlertaStockRepository <<implementado>> {
    +buscar(page, productoId)
    +resumir(): ResumenAlertaStockResponse
  }
  class ResumenAlertaStockResponse <<implementado>> {
    +asOf: Instant
    +productosEnAlerta: long
  }
 }
 package "Contabilidad" {
  class ResultadoFinancieroController <<implementado>> {
    +consultar(periodId): ResultadoFinancieroResponse
  }
  class ResultadoFinancieroService <<implementado>> {
    +consultar(periodId): ResultadoFinancieroResponse
  }
  class EstadosFinancierosService <<implementado>> {
    +resultados(periodId)
    +flujo(periodId)
  }
  class ResultadoFinancieroResponse <<implementado>> {
    +periodoId: Long
    +inicio: LocalDate
    +fin: LocalDate
    +resultado: BigDecimal
  }
 }
 package "Referencia transversal" {
  class Usuario <<Seguridad>>
  class Permiso <<Seguridad>>
 }
 enum EstadoEvento {
  PENDIENTE
  PROCESADO
  ERROR
}
 enum FormatoReporte {
  PANTALLA
  PDF
  CSV
  XLSX
}
 enum NotificationType {
  STOCK_BAJO
  APROBACION_PENDIENTE
  RESULTADO_OPERACION
 }
 enum NotificationStatus {
  NO_LEIDA
  LEIDA
 }
 enum EstadoReporte {
  SOLICITADO
  EJECUTANDO
  COMPLETADO
  FALLIDO
}

 Usuario "0..1" <-- "0..*" EventoAuditoria : actor opcional
 ReportQueryService ..> ReportCriteria : valida
 ReportQueryService ..> ReportResult : proyecta
 ReportQueryService ..> Permiso : verifica acceso
 DashboardController ..> DashboardService
 DashboardService ..> PrepararDashboardService : valida y autoriza
 DashboardService ..> FacturacionProveedorReportService
 DashboardService ..> FacturacionVentaReportService
 DashboardService ..> AlertaStockService
 DashboardService ..> ResultadoFinancieroService
 DashboardService ..> DashboardResponse
 DashboardResponse ..> IndicadorDashboardResponse
 PrepararDashboardService ..> CriteriosDashboard : valida y prepara
 CriteriosDashboard ..> IndicadorDashboard
 FacturacionProveedorReportController ..> FacturacionProveedorReportService : consulta protegida
 FacturacionProveedorReportService ..> FacturacionProveedorReportResponse
 FacturacionVentaReportController ..> FacturacionVentaReportService : consulta protegida
 FacturacionVentaReportService ..> FacturacionVentaReportResponse
 ResumenAlertaStockController ..> AlertaStockService
 AlertaStockService ..> AlertaStockRepository
 AlertaStockRepository ..> ResumenAlertaStockResponse
 ResultadoFinancieroController ..> ResultadoFinancieroService
 ResultadoFinancieroService ..> EstadosFinancierosService : reutiliza resultados
 ResultadoFinancieroService ..> ResultadoFinancieroResponse
 Usuario "1" <-- "0..*" EjecucionReporte : solicitante
 DefinicionReporte "1" -- "0..*" EjecucionReporte
 Permiso "1" <-- "0..*" DefinicionReporte : permiso requerido
 Indicador "1" -- "0..*" ValorIndicador
 Usuario "1" <-- "0..*" Notificacion : destinatario obligatorio
 Usuario "0..1" <-- "0..*" ParametroSistema : actualizado por

note bottom of EventoAuditoria
  Registra acciones y nombres de campos, sin valores sensibles.
end note

 note bottom of EventoIntegracion
  Componente opcional del monolito. Puede materializar el patron
  Outbox para procesar eventos/reintentos tras confirmar la transaccion.
 end note

note bottom of Notificacion
  La entrega se procesa después de confirmar la transacción.
  El destinatario consulta su propia bandeja.
end note

 note right of EjecucionReporte
  Los filtros, resultados y exportaciones aplican permisos de datos;
  no exponer salarios, datos personales o finanzas sin autorizacion.
 end note

note bottom of Indicador
  Cada indicador tiene fórmula, fuente, unidad y periodo definidos.
end note

 note bottom of ReportQueryService
  Servicio genérico de reportería: diseño objetivo.
  Solo lectura: agrega datos confirmados en PostgreSQL,
  aplica alcance de filas antes de contar o sumar.
  No llama operaciones de modificación ni expone entidades JPA.
 end note
 note right of PrepararDashboardService
  Selecciona indicadores según autoridades actuales.
  Es una base interna; no consulta datos ni expone una API.
 end note
 note right of FacturacionProveedorReportService
  Suma subtotales de facturas de proveedor validadas
  por fecha de emisión con permiso de lectura de facturas.
  Endpoint independiente; también usado por dashboard.
 end note
 note right of FacturacionVentaReportService
  Suma subtotales de facturas comerciales emitidas
  por fecha de emisión, con permiso de lectura de facturas.
  No representa cobro; también usado por dashboard.
 end note
 note right of AlertaStockRepository
  Listado y resumen comparten la regla global.
  El resumen informa el inicio de la sentencia; no es histórico.
 end note
 note right of ResultadoFinancieroService
  Proyecta el rubro RESULTADO con permiso financiero.
  El margen operativo usa clasificaciones explícitas
  y versionadas; no infiere históricos.
 end note
 note right of DashboardService
  Solo consulta fuentes autorizadas en una instantánea
  REPEATABLE_READ. No consulta el periodo sin permiso financiero.
 end note
note "Dashboard CSV usa DASHBOARD_CSV_GENERATED.\nLa exportación general admite CSV/PDF/XLSX\npor página y registra REPORT_FILE_GENERATED.\nAnalíticas aplican permisos y pueden responder\nNO_DISPONIBLE ante falta de cobertura. Nómina fuera." as CSVParte9
@enduml
