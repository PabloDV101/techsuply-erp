@startuml ERP_06_Reporteria_Auditoria_Integracion
!include ../_estilo.iuml
caption VISTA MIXTA · Auditoría V4 y bandeja APP V5 implementadas; reportería e integración son objetivo.
 title TechSupply Solutions - Reportería, auditoría e integración
 hide circle

 package "Auditoria e integracion" {
  class EventoAuditoria <<implementado>> {
  +id: Long
  +fecha: Instant
  +usuarioId: Long
  +actorTipo: AuditActorType
  +modulo: String
  +accion: String
  +entidad: String
  +entidadId: Long
  +resultado: AuditResult
  +motivoCodigo: String
  +detalle: JSON
}
  class EventoIntegracion <<OpcionalMVP>> {
  +id: Long
  +tipoEvento: String
  +entidadOrigen: String
  +entidadOrigenId: Long
  +claveIdempotencia: String
  +fechaCreacion: DateTime
  +fechaProcesamiento: DateTime
  +estado: EstadoEvento
  +intentos: Integer
  +mensajeError: String
}
 }
 package "Reporteria" {
  class DefinicionReporte {
  +id: Long
  +codigo: String
  +nombre: String
  +descripcion: String
  +modulo: String
  +consultaClave: String
  +permisoRequerido: String
  +activo: Boolean
}
  class EjecucionReporte {
  +id: Long
  +fechaHora: DateTime
  +parametros: JSON
  +formato: FormatoReporte
  +estado: EstadoReporte
  +filasGeneradas: Long
  +duracionMs: Long
}
  class Indicador {
  +id: Long
  +codigo: String
  +nombre: String
  +descripcion: String
  +unidad: String
  +formula: String
  +fuenteDatos: String
  +frecuenciaActualizacion: String
  +activo: Boolean
}
  class "InternalNotification" as Notificacion <<implementado>> {
    +id: Long
    +usuarioId: Long
    +tipoEvento: NotificationType
    +modulo: String
    +entidad: String
    +entidadId: Long
    +claveOperacion: String
    +canal: String
    +asunto: String
    +cuerpo: String
    +estado: NotificationStatus
    +creadaEn: Instant
    +leidaEn: Instant
  }
  class ParametroSistema {
    +id: Long
    +modulo: String
    +clave: String
    +valor: String
    +actualizadoEn: DateTime
  }
  class ValorIndicador {
  +id: Long
  +fechaCalculo: DateTime
  +periodoInicio: Date
  +periodoFin: Date
  +valor: Decimal
}
 }
 package "Referencia transversal" {
  class Usuario <<Seguridad>>
  class Permiso <<Seguridad>>
 }
 enum EstadoEvento {
  PENDIENTE
  PROCESADO
  ERROR
}
 enum FormatoReporte {
  PANTALLA
  PDF
  CSV
  XLSX
}
 enum NotificationType {
  STOCK_BAJO
  APROBACION_PENDIENTE
  RESULTADO_OPERACION
 }
 enum NotificationStatus {
  NO_LEIDA
  LEIDA
 }
 enum EstadoReporte {
  SOLICITADO
  EJECUTANDO
  COMPLETADO
  FALLIDO
}

 Usuario "0..1" <-- "0..*" EventoAuditoria : actor opcional
 Usuario "1" <-- "0..*" EjecucionReporte : solicitante
 DefinicionReporte "1" -- "0..*" EjecucionReporte
 Permiso "1" <-- "0..*" DefinicionReporte : permiso requerido
 Indicador "1" -- "0..*" ValorIndicador
 Usuario "1" <-- "0..*" Notificacion : destinatario obligatorio
 Usuario "0..1" <-- "0..*" ParametroSistema : actualizado por

 note bottom of EventoAuditoria
  V4: solo adición para seguridad y categorías.
  Detalle cerrado: nombres de campos/estados, sin valores ni secretos.
  Aprobaciones y operaciones financieras son objetivo de módulos futuros.
 end note
 note bottom of EventoIntegracion
  Componente opcional del monolito. Puede materializar el patron
  Outbox para procesar eventos/reintentos tras confirmar la transaccion.
 end note
 note bottom of Notificacion
  V5: solo canal APP, lectura propia e inserción tras commit.
  Los productores de negocio aún no están conectados.
  EMAIL, Outbox y reintentos automáticos son objetivos opcionales.
 end note
 note right of EjecucionReporte
  Los filtros, resultados y exportaciones aplican permisos de datos;
  no exponer salarios, datos personales o finanzas sin autorizacion.
 end note
 note bottom of Indicador
  Fórmula, fuente, unidad y periodo deben estar definidos antes de
  presentar un KPI como cifra oficial.
 end note
@enduml
