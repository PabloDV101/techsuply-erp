@startuml ERP_06_Reporteria_Auditoria_Integracion
!include ../_estilo.iuml
 title TechSupply Solutions - Reportería, auditoría e integración
 hide circle

 package "Auditoria e integracion" {
  class EventoAuditoria {
  -id: Long
  -fecha: Instant
  -usuarioId: Long
  -actorTipo: AuditActorType
  -modulo: String
  -accion: String
  -entidad: String
  -entidadId: Long
  -resultado: AuditResult
  -motivoCodigo: String
  -detalle: JSON
}
  class EventoIntegracion {
  -id: Long
  -tipoEvento: String
  -entidadOrigen: String
  -entidadOrigenId: Long
  -claveIdempotencia: String
  -fechaCreacion: DateTime
  -fechaProcesamiento: DateTime
  -estado: EstadoEvento
  -intentos: Integer
  -mensajeError: String
}
 }
 package "Reporteria" {
  class "Criterios por reporte (DTO)" as ReportCriteria {
    -periodo: DateRange
    -filtros: criterios validados
    -pagina: Pageable
  }
  class "Resultado por reporte (DTO)" as ReportResult {
    -fuente: String
    -periodo: DateRange
    -disponibilidad: DISPONIBLE | NO_DISPONIBLE
    -filas: proyecciones
  }
  class "Servicio de consulta por reporte" as ReportQueryService {
    +consultar(criteria): ReportResult
  }
  class DefinicionReporte {
  -id: Long
  -codigo: String
  -nombre: String
  -descripcion: String
  -modulo: String
  -consultaClave: String
  -permisoRequerido: String
  -activo: Boolean
}
  class EjecucionReporte {
  -id: Long
  -fechaHora: DateTime
  -parametros: JSON
  -formato: FormatoReporte
  -estado: EstadoReporte
  -filasGeneradas: Long
  -duracionMs: Long
}
  class Indicador {
  -id: Long
  -codigo: String
  -nombre: String
  -descripcion: String
  -unidad: String
  -formula: String
  -fuenteDatos: String
  -frecuenciaActualizacion: String
  -activo: Boolean
}
  class "InternalNotification" as Notificacion {
    -id: Long
    -usuarioId: Long
    -tipoEvento: NotificationType
    -modulo: String
    -entidad: String
    -entidadId: Long
    -claveOperacion: String
    -canal: String
    -asunto: String
    -cuerpo: String
    -estado: NotificationStatus
    -creadaEn: Instant
    -leidaEn: Instant
  }
  class ParametroSistema {
    -id: Long
    -modulo: String
    -clave: String
    -valor: String
    -actualizadoEn: DateTime
  }
  class ValorIndicador {
  -id: Long
  -fechaCalculo: DateTime
  -periodoInicio: Date
  -periodoFin: Date
  -valor: Decimal
}
 }
 package "Referencia transversal" {
  class Usuario <<Seguridad>>
  class Permiso <<Seguridad>>
 }
 enum EstadoEvento {
  PENDIENTE
  PROCESADO
  ERROR
}
 enum FormatoReporte {
  PANTALLA
  PDF
  CSV
  XLSX
}
 enum NotificationType {
  STOCK_BAJO
  APROBACION_PENDIENTE
  RESULTADO_OPERACION
 }
 enum NotificationStatus {
  NO_LEIDA
  LEIDA
 }
 enum EstadoReporte {
  SOLICITADO
  EJECUTANDO
  COMPLETADO
  FALLIDO
}

 Usuario "0..1" <-- "0..*" EventoAuditoria : actor opcional
 ReportQueryService ..> ReportCriteria : valida
 ReportQueryService ..> ReportResult : proyecta
 ReportQueryService ..> Permiso : verifica acceso
 Usuario "1" <-- "0..*" EjecucionReporte : solicitante
 DefinicionReporte "1" -- "0..*" EjecucionReporte
 Permiso "1" <-- "0..*" DefinicionReporte : permiso requerido
 Indicador "1" -- "0..*" ValorIndicador
 Usuario "1" <-- "0..*" Notificacion : destinatario obligatorio
 Usuario "0..1" <-- "0..*" ParametroSistema : actualizado por

note bottom of EventoAuditoria
  Registra acciones y nombres de campos, sin valores sensibles.
end note

 note bottom of EventoIntegracion
  Componente opcional del monolito. Puede materializar el patron
  Outbox para procesar eventos/reintentos tras confirmar la transaccion.
 end note

note bottom of Notificacion
  La entrega se procesa después de confirmar la transacción.
  El destinatario consulta su propia bandeja.
end note

 note right of EjecucionReporte
  Los filtros, resultados y exportaciones aplican permisos de datos;
  no exponer salarios, datos personales o finanzas sin autorizacion.
 end note

note bottom of Indicador
  Cada indicador tiene fórmula, fuente, unidad y periodo definidos.
end note

 note bottom of ReportQueryService
  Solo lectura: agrega datos confirmados en PostgreSQL,
  aplica alcance de filas antes de contar o sumar.
  No llama operaciones de modificación ni expone entidades JPA.
 end note
@enduml
