@startuml ERP_03_Ventas
 title TechSupply Solutions - Vista logica: Ventas y devoluciones de clientes (v1.1)
 hide circle
 skinparam classAttributeIconSize 0
 skinparam linetype ortho
 skinparam shadowing false
 skinparam packageStyle rectangle

 package "Ventas" {
  class Cotizacion {
  +id: UUID
  +folio: String
  +fecha: DateTime
  +vigenciaHasta: Date
  +estado: EstadoCotizacion
  +subtotal: Decimal
  +impuestos: Decimal
  +total: Decimal
  +convertirAPedido()
}
  class DetalleCotizacion {
  +id: UUID
  +cantidad: Decimal
  +precioUnitario: Decimal
  +descuentoPct: Decimal
  +tasaImpuesto: Decimal
}
  class PedidoVenta {
  +id: UUID
  +folio: String
  +fecha: DateTime
  +canal: CanalVenta
  +estado: EstadoPedido
  +subtotal: Decimal
  +impuestos: Decimal
  +total: Decimal
  +confirmar()
  +cancelar()
}
  class DetallePedido {
  +id: UUID
  +cantidad: Decimal
  +cantidadReservada: Decimal
  +cantidadDespachada: Decimal
  +precioUnitario: Decimal
  +descuentoPct: Decimal
  +tasaImpuesto: Decimal
}
  class Despacho {
  +id: UUID
  +folio: String
  +fecha: DateTime
  +estado: EstadoDespacho
  +claveIdempotencia: String
  +confirmar()
}
  class DetalleDespacho {
  +id: UUID
  +cantidad: Decimal
  +costoUnitario: Decimal
}
  class FacturaVenta {
  +id: UUID
  +folio: String
  +fechaEmision: Date
  +fechaVencimiento: Date
  +subtotal: Decimal
  +impuestos: Decimal
  +total: Decimal
  +estado: EstadoFactura
}
  class DetalleFacturaVenta {
  +id: UUID
  +cantidad: Decimal
  +precioUnitario: Decimal
  +descuentoPct: Decimal
  +tasaImpuesto: Decimal
  +subtotal: Decimal
  +impuestos: Decimal
  +total: Decimal
}
  class DevolucionCliente {
  +id: UUID
  +folio: String
  +fecha: DateTime
  +motivo: String
  +claveIdempotencia: String
  +estado: EstadoDevolucionCliente
  +confirmarInspeccion()
}
  class DetalleDevolucionCliente {
  +id: UUID
  +cantidadRecibida: Decimal
  +cantidadAceptada: Decimal
  +cantidadRechazada: Decimal
}
 }
 package "Referencias a otros modulos" {
  class Cliente <<GestionMaestra>>
  class Producto <<GestionMaestra>>
  class Usuario <<Seguridad>>
  class Almacen <<GestionMaestra>>
  class CuentaPorCobrar <<Contabilidad>>
 }
 enum EstadoCotizacion {
  BORRADOR
  VIGENTE
  ACEPTADA
  VENCIDA
  CANCELADA
}
 enum CanalVenta {
  INTERNO
  PORTAL
}
 enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  PARCIALMENTE_DESPACHADO
  DESPACHADO
  FACTURADO
  CANCELADO
}
 enum EstadoDespacho {
  BORRADOR
  CONFIRMADO
  CANCELADO
}
 enum EstadoFactura {
  EMITIDA
  PARCIALMENTE_PAGADA
  PAGADA
  VENCIDA
  CANCELADA
}
 enum EstadoDevolucionCliente {
  BORRADOR
  PENDIENTE_INSPECCION
  CONFIRMADA
  RECHAZADA
  CANCELADA
}

 Cliente "1" <-- "0..*" Cotizacion
 Usuario "1" <-- "0..*" Cotizacion : vendedor
 Cotizacion "1" *-- "1..*" DetalleCotizacion
 DetalleCotizacion "0..*" --> "1" Producto
 Cotizacion "0..1" <-- "0..1" PedidoVenta : origen opcional
 Cliente "1" <-- "0..*" PedidoVenta
 Usuario "1" <-- "0..*" PedidoVenta : creador / vendedor
 PedidoVenta "1" *-- "1..*" DetallePedido
 DetallePedido "0..*" --> "1" Producto
 PedidoVenta "1" -- "0..*" Despacho
 Despacho "1" *-- "1..*" DetalleDespacho
 DetalleDespacho "0..*" --> "1" DetallePedido
 Despacho "0..*" --> "1" Almacen
 Despacho "0..*" --> "1" Usuario : responsable
 PedidoVenta "1" -- "0..1" FacturaVenta : una factura al despachar completo
 FacturaVenta "1" *-- "1..*" DetalleFacturaVenta
 DetalleFacturaVenta "0..*" --> "1" DetallePedido : copia de linea y precio
 DetalleFacturaVenta "0..*" --> "1" Producto
 FacturaVenta "1" -- "0..1" CuentaPorCobrar : genera cuenta
 PedidoVenta "1" -- "0..*" DevolucionCliente
 DevolucionCliente "1" *-- "1..*" DetalleDevolucionCliente
 DetalleDevolucionCliente "0..*" --> "1" DetallePedido : linea original
 DevolucionCliente "0..*" --> "1" Cliente
 DevolucionCliente "0..*" --> "1" Almacen : almacen de inspeccion
 DevolucionCliente "0..*" --> "1" Usuario : registrada por
 DevolucionCliente "0..*" --> "0..1" Usuario : autorizada por

 note bottom of PedidoVenta
  Al confirmar: validar cliente activo, precio, descuento, credito
  si aplica y disponibilidad. La reserva se hace atomica en Inventario.
 end note
 note bottom of FacturaVenta
  Una factura comercial por pedido, cuando el pedido queda totalmente
  despachado. No implica timbrado CFDI/SAT en este MVP.
 end note
 note bottom of DevolucionCliente
  La cantidad recibida se inspecciona; solo las unidades aceptadas
  aumentan existencias. La operacion deja movimiento y auditoria.
 end note
@enduml
