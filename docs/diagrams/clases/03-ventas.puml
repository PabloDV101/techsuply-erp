@startuml ERP_03_Ventas
!include ../_estilo.iuml
 title TechSupply Solutions — Cotizaciones, pedidos y despachos
 hide circle

 package "Ventas" {
  class Cotizacion {
  -id: Long
  -folio: String
  -fecha: DateTime
  -vigenciaHasta: Date
  -claveIdempotencia: String
  -estado: EstadoCotizacion
  -subtotal: Decimal
  -impuestos: Decimal
  -total: Decimal
  +convertirAPedido()
}
  class DetalleCotizacion {
  -id: Long
  -cantidad: Decimal
  -precioUnitario: Decimal
  -descuentoPct: Decimal
  -tasaImpuesto: Decimal
}
  class PedidoVenta {
  -id: Long
  -folio: String
  -fecha: DateTime
  -canal: CanalVenta
  -modalidad: ModalidadVenta
  -claveIdempotencia: String
  -estado: EstadoPedido
  -subtotal: Decimal
  -impuestos: Decimal
  -total: Decimal
  -motivoCancelacion: String [0..1]
  -canceladoEn: DateTime [0..1]
  -canceladoPorUsuarioId: Long [0..1]
  +confirmar()
  +cancelar()
}
  class DetallePedido {
  -id: Long
  -cantidad: Decimal
  -cantidadReservada: Decimal
  -cantidadDespachada: Decimal
  -precioUnitario: Decimal
  -descuentoPct: Decimal
  -tasaImpuesto: Decimal
}
  class Despacho {
  -id: Long
  -folio: String
  -fecha: DateTime
  -estado: EstadoDespacho
  -claveIdempotencia: String
  +confirmar()
  +cancelar()
}
  class DetalleDespacho {
  -id: Long
  -cantidad: Decimal
  -costoUnitario: Decimal [0..1]
}


 }
 package "Referencias a otros modulos" {
  class Cliente <<GestionMaestra>>
  class Producto <<GestionMaestra>>
  class Usuario <<Seguridad>>
  class Almacen <<GestionMaestra>>
 }
 enum EstadoCotizacion {
  BORRADOR
  VIGENTE
  ACEPTADA
  VENCIDA
  CANCELADA
}
 enum CanalVenta {
  INTERNO
  PORTAL
}
 enum ModalidadVenta {
  CONTADO
  CREDITO
}
 enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  PARCIALMENTE_DESPACHADO
  DESPACHADO
  FACTURADO
  CANCELADO
}
 enum EstadoDespacho {
  BORRADOR
  CONFIRMADO
  CANCELADO
}



 EstadoCotizacion -[hidden]-> Cotizacion
 CanalVenta -[hidden]-> PedidoVenta
 ModalidadVenta -[hidden]-> PedidoVenta
 EstadoPedido -[hidden]-> PedidoVenta
 EstadoDespacho -[hidden]-> Despacho

 Cliente "1" <-- "0..*" Cotizacion
 Usuario "1" <-- "0..*" Cotizacion : vendedor
 Cotizacion "1" *-- "0..*" DetalleCotizacion
 DetalleCotizacion "0..*" --> "1" Producto
 Cotizacion "1" <-- "0..1" PedidoVenta : origen
 Cliente "1" <-- "0..*" PedidoVenta
 Usuario "1" <-- "0..*" PedidoVenta : creador
 Usuario "1" <-- "0..*" PedidoVenta : vendedor
 Usuario "0..1" <-- "0..*" PedidoVenta : cancelador
 PedidoVenta "1" *-- "0..*" DetallePedido
 DetallePedido "0..*" --> "1" Producto
 PedidoVenta "1" -- "0..*" Despacho
 Despacho "1" *-- "0..*" DetalleDespacho
 DetalleDespacho "0..*" --> "1" DetallePedido
 Despacho "0..*" --> "1" Almacen
 Despacho "0..*" --> "1" Usuario : responsable

note bottom of PedidoVenta
  Las operaciones confirmadas requieren líneas válidas.
  El precio acordado se conserva al convertir la cotización.
  La cancelación del saldo libera la reserva pendiente y
  conserva los despachos confirmados.
end note

@enduml
