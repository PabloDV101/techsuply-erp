@startuml ERP_01_Gestion_Maestra_Seguridad
!include ../_estilo.iuml
 title TechSupply Solutions - Vista lógica: Gestión maestra y seguridad
 hide circle

 package "Seguridad" {
  class Usuario {
    -id: Long
    -username: String
    -correo: String
    -passwordHash: String
    -empleadoId: Long [0..1]
    -clienteId: Long [0..1]
    -activo: boolean
    -intentosFallidos: short
    -bloqueadoHasta: Instant [0..1]
    -ultimoAcceso: Instant [0..1]
    -creadoEn: Instant
    +incrementarIntentosFallidos()
    +reiniciarIntentosFallidos()
  }
  class IdentificadorUsuario {
    identificador: String {PK, unique}
    usuarioId: Long {FK}
  }
  class AsignacionRol {
    usuarioId: Long
    rolId: Long
    asignadoPorUsuarioId: Long [0..1]
    asignadoEn: Instant
  }
  class Rol {
    -id: Long
    -codigo: String
    -nombre: String
    -descripcion: String [0..1]
    -activo: boolean
  }
  class Permiso {
    -id: Long
    -codigo: String
    -modulo: String
    -accion: String
    -descripcion: String [0..1]
  }
  class SolicitudAutorizacion {
    -id: Long
    -tipo: String
    -entidadTipo: String
    -entidadId: Long
    -estado: EstadoAutorizacion
    -motivo: String
    -solicitadaEn: DateTime
    -resueltaEn: DateTime
  }
  class TokenSesion {
    -id: Long
    -tokenHash: String
    -emitidoEn: Instant
    -venceEn: Instant
    -revocadoEn: Instant [0..1]
  }
  class EventoAuditoria {
  -id: Long
  -fecha: Instant
  -usuarioId: Long
  -actorTipo: AuditActorType
  -modulo: String
  -accion: String
  -entidad: String
  -entidadId: Long
  -resultado: AuditResult
  -motivoCodigo: String
  -detalle: JSON
}
 }
 package "Estructura organizacional" {
  class Empleado {
  -id: Long
  -numeroEmpleado: String
  -nombres: String
  -apellidos: String
  -fechaIngreso: Date
  -activo: Boolean
}
  class Departamento {
  -id: Long
  -codigo: String
  -nombre: String
  -activo: boolean
}
  class Puesto {
  -id: Long
  -codigo: String
  -nombre: String
  -activo: Boolean
}
 }
 package "Catalogos comerciales" {
  class Cliente {
  -id: Long
  -codigo: String
  -nombreRazonSocial: String
  -identificadorFiscal: String
  -correo: String
  -telefono: String
  -direccion: String
  -limiteCredito: Decimal
  -plazoCreditoDias: Integer
  -activo: Boolean
}
  class Proveedor {
  -id: Long
  -codigo: String
  -nombreRazonSocial: String
  -identificadorFiscal: String
  -contacto: String
  -correo: String
  -telefono: String
  -direccion: String
  -plazoCreditoDias: short
  -activo: boolean
}
  class CategoriaProducto {
  -id: Long
  -codigo: String
  -nombre: String
  -descripcion: String [0..1]
  -activa: Boolean
}
  class Producto {
  -id: Long
  -sku: String
  -nombre: String
  -descripcion: String
  -unidadMedida: String
  -precioLista: BigDecimal
  -costoReferencia: BigDecimal
  -tasaImpuesto: BigDecimal
  -puntoReorden: BigDecimal
  -cantidadReorden: BigDecimal
  -activo: boolean
}
  class Almacen {
  -id: Long
  -codigo: String
  -nombre: String
  -sede: String
  -ubicacion: String
  -activo: boolean
}
 }
 enum EstadoAutorizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

 Usuario "0..1" -- "0..1" Empleado : vínculo
 Usuario "0..1" -- "0..1" Cliente : vínculo
 Usuario "1" -- "0..*" AsignacionRol
 Rol "1" -- "0..*" AsignacionRol
 AsignacionRol "0..*" --> "0..1" Usuario : asignado por
 Rol "0..*" -- "0..*" Permiso : roles_permisos
 Empleado "0..*" --> "1" Departamento : asignacion
 Empleado "0..*" --> "1" Puesto : asignacion
 Empleado "0..*" --> "0..1" Empleado : jefe
 CategoriaProducto "0..1" <-- "0..*" CategoriaProducto : categoria padre
 CategoriaProducto "1" -- "0..*" Producto : clasifica
 Proveedor "0..1" <-- "0..*" Producto : proveedor principal
 Usuario "0..1" -- "0..*" EventoAuditoria : actor opcional
 Usuario "1" -- "1..2" IdentificadorUsuario : identificadores_usuario
 Usuario "1" -- "0..*" TokenSesion
 Usuario "1" -- "0..*" SolicitudAutorizacion : solicitante
 Usuario "0..1" <-- "0..*" SolicitudAutorizacion : resuelve

note right of Usuario
  Una cuenta puede vincularse a un empleado o a un cliente,
  nunca a ambos. Las cuentas técnicas pueden no tener vínculo.
  El servidor valida permisos para cada operación.
end note

 note right of IdentificadorUsuario
  Tabla SQL, sin entidad JPA; el trigger sincroniza username/correo.
  PK compartida evita ambigüedad y colisiones concurrentes.
  Si username = correo, solo hay una fila; en otro caso hay dos.
 end note
 note bottom of AsignacionRol
  Tabla usuarios_roles con PK(usuario_id, rol_id).
  No es clase Java: @ManyToMany + UPDATE nativo guarda asignador/fecha.
  Roles y permisos se unen mediante roles_permisos con PK compuesta.
 end note
 note bottom of TokenSesion
  Bearer opaco: 32 bytes aleatorios, SHA-256 persistido.
  Vigencia de dos horas; revocado_en invalida solicitudes posteriores.
 end note

note bottom of Producto
  SKU único; categoría obligatoria y proveedor principal opcional.
  El stock se gestiona por producto y almacén.
end note

note bottom of EventoAuditoria
  El historial registra acciones y metadatos seguros,
  sin contraseñas, tokens ni secretos.
end note

@enduml
