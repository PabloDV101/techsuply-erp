@startuml ERP_01_Gestion_Maestra_Seguridad
 title TechSupply Solutions - Vista logica: Gestion maestra y seguridad (v1.1)
 hide circle
 skinparam classAttributeIconSize 0
 skinparam linetype ortho
 skinparam shadowing false
 skinparam packageStyle rectangle

 package "Seguridad" {
  class Usuario {
    +id: UUID
    +nombreUsuario: String
    +correo: String
    +hashContrasena: String
    +activo: Boolean
    +fechaCreacion: DateTime
    +ultimoAcceso: DateTime
  }
  class AsignacionRol {
    +usuarioId: UUID
    +rolId: UUID
    +asignadoPorUsuarioId: UUID
    +asignadoEn: DateTime
  }
  class Rol {
  +id: UUID
  +codigo: String
  +nombre: String
  +activo: Boolean
}
  class Permiso {
  +id: UUID
  +codigo: String
  +modulo: String
  +accion: String
}
  class SolicitudAutorizacion {
    +id: UUID
    +tipo: String
    +entidadTipo: String
    +entidadId: UUID
    +estado: EstadoAutorizacion
    +motivo: String
    +solicitadaEn: DateTime
    +resueltaEn: DateTime
  }
  class TokenSesion {
  +id: UUID
  +tokenHash: String
  +emitidoEn: DateTime
  +venceEn: DateTime
  +revocadoEn: DateTime
}
  class EventoAuditoria {
  +id: UUID
  +fechaHora: DateTime
  +accion: String
  +entidad: String
  +entidadId: UUID
  +resultado: String
  +valoresAnteriores: JSON
  +valoresNuevos: JSON
}
 }
 package "Estructura organizacional" {
  class Empleado {
  +id: UUID
  +numeroEmpleado: String
  +nombres: String
  +apellidos: String
  +fechaIngreso: Date
  +activo: Boolean
}
  class Departamento {
  +id: UUID
  +codigo: String
  +nombre: String
  +activo: Boolean
}
  class Puesto {
  +id: UUID
  +codigo: String
  +nombre: String
  +activo: Boolean
}
 }
 package "Catalogos comerciales" {
  class Cliente {
  +id: UUID
  +codigo: String
  +nombreRazonSocial: String
  +identificadorFiscal: String
  +limiteCredito: Decimal
  +plazoCreditoDias: Integer
  +activo: Boolean
}
  class Proveedor {
  +id: UUID
  +codigo: String
  +nombreRazonSocial: String
  +identificadorFiscal: String
  +plazoCreditoDias: Integer
  +activo: Boolean
}
  class CategoriaProducto {
  +id: UUID
  +codigo: String
  +nombre: String
  +activa: Boolean
}
  class Producto {
  +id: UUID
  +sku: String
  +nombre: String
  +unidadMedida: String
  +precioLista: Decimal
  +costoReferencia: Decimal
  +puntoReorden: Decimal
  +activo: Boolean
}
  class Almacen {
  +id: UUID
  +codigo: String
  +nombre: String
  +sede: String
  +activo: Boolean
}
 }
 enum EstadoAutorizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

 Usuario "0..1" -- "0..1" Empleado : cuenta interna
 Usuario "0..1" -- "0..1" Cliente : cuenta del portal
 Usuario "1" -- "0..*" AsignacionRol
 Rol "1" -- "0..*" AsignacionRol
 AsignacionRol "0..*" --> "0..1" Usuario : asignado por
 Rol "0..*" -- "0..*" Permiso : roles_permisos
 Empleado "0..*" --> "1" Departamento : asignacion actual
 Empleado "0..*" --> "1" Puesto : asignacion actual
 Empleado "0..*" --> "0..1" Empleado : jefe
 CategoriaProducto "0..1" <-- "0..*" CategoriaProducto : categoria padre
 CategoriaProducto "1" -- "0..*" Producto : clasifica
 Proveedor "0..1" <-- "0..*" Producto : proveedor principal
 Usuario "0..*" -- "0..1" EventoAuditoria : actor opcional
 Usuario "1" -- "0..*" TokenSesion
 Usuario "1" -- "0..*" SolicitudAutorizacion : solicitante
 Usuario "0..1" <-- "0..*" SolicitudAutorizacion : resuelve

 note right of Usuario
  IDs UUID en el modelo y en las vistas UML.
  La cuenta puede vincularse a un empleado o a un cliente,
  nunca a ambos. La cuenta de cliente solo ve sus datos.
  Las cuentas tecnicas/admin pueden no tener vinculo persona.
  El backend valida permisos; React solo presenta opciones.
 end note
 note bottom of Producto
  SKU unico. El stock real no se guarda en Producto:
  existencias se controla por producto y almacen.
 end note
 note bottom of EventoAuditoria
  Registro de solo adicion para cambios/operaciones criticas.
  No almacenar contrasenas, tokens ni secretos.
 end note
@enduml
