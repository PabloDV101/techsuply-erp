@startuml TechSupply_Backend_Components
!include ../_estilo.iuml
title TechSupply Solutions — Capas y componentes de Spring Boot
top to bottom direction
package "API" {
  component "Controladores REST" as Controllers
  component "DTO y Bean Validation" as DTO
  component "Spring Security" as Security
  component "Manejo de errores" as Errors
}
package "Aplicación" {
  component "Servicios transaccionales" as Services
  interface "AuditTrail" as AuditPort
}
package "Dominio" {
  component "Modelos y reglas\nde negocio" as Domain
  component "Cálculos deterministas" as Calculation
}
package "Infraestructura" {
  component "Repositorios Spring Data JPA" as Repositories
  component "Auditoría" as Audit
  component "Migraciones Flyway" as Flyway
}
database "PostgreSQL" as DB
Controllers ..> Security : autorización
Controllers ..> DTO : validación
Controllers ..> Errors : respuesta HTTP
Controllers ..> Services : casos de uso
Services ..> Domain : aplica reglas
Domain ..> Calculation
Services ..> Repositories
Services ..> AuditPort
Audit ..|> AuditPort
Repositories ..> DB : JDBC
Audit ..> DB : registro
Flyway ..> DB : migraciones
note bottom of Services
  El servicio coordina transacciones y llama a los contratos
  de los módulos involucrados; las reglas permanecen en dominio.
end note
@enduml
