@startuml TechSupply_Reusable_Components
 title TechSupply Solutions - Componentes reutilizables y contratos
 left to right direction
 skinparam componentStyle uml2
 skinparam shadowing false
 skinparam linetype ortho
 skinparam packageStyle rectangle
 skinparam nodesep 32
 skinparam ranksep 38
 skinparam defaultTextAlignment center

 package "Implementaciones compartidas" as Providers {
   component "Spring Security\nFilter Chain + @PreAuthorize" as Security
   component "Jakarta Validation\nDTOs de entrada" as InputValidation
   component "AuditService" as Audit
   component "Búsqueda común\nPageable / Specification" as Search
   component "NotificationService\nAFTER_COMMIT" as Notify
   component "Reporting query services" as Reports
   component "GlobalExceptionHandler" as Errors
 }

 interface "AuditPort" as IAudit
 interface "SearchPort" as ISearch
 interface "NotificationPort" as INotify
 interface "ReportQueryPort" as IReports

 package "Módulos consumidores" as Consumers {
   component "Gestión maestra" as Masters
   component "Compras" as Purchases
   component "Inventario" as Inventory
   component "Ventas" as Sales
   component "Contabilidad" as Accounting
   component "RR. HH. / nómina" as Payroll
 }

 Audit - IAudit
 Search - ISearch
 Notify - INotify
 Reports - IReports

 Masters ..> IAudit
 Purchases ..> IAudit
 Inventory ..> IAudit
 Sales ..> IAudit
 Accounting ..> IAudit
 Payroll ..> IAudit

 Masters ..> ISearch
 Purchases ..> ISearch
 Inventory ..> ISearch
 Sales ..> ISearch

 Purchases ..> INotify
 Inventory ..> INotify
 Sales ..> INotify
 Payroll ..> INotify

 Reports ..> IReports

 note bottom of Security
   Los permisos se aplican en la API y en casos de uso sensibles.
   Ocultar botones en React no es un control de seguridad.
 end note

 note bottom of InputValidation
   Las reglas de entrada comunes se reutilizan aquí;
   las invariantes comerciales (stock, saldos, estados) viven
   en el módulo responsable y se validan en el servidor.
 end note

 note bottom of Audit
   @Transactional define la atomicidad en los servicios de aplicación;
   no es un microservicio ni un componente remoto independiente.
 end note

 note right of Notify
   Las notificaciones salen después del commit para no enviar
   avisos sobre operaciones que finalmente se revierten.
   Para garantías más fuertes, añadir patrón outbox en el futuro.
 end note
@enduml
