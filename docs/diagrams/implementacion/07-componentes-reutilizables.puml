@startuml TechSupply_Reusable_Components
!include ../_estilo.iuml
title TechSupply Solutions — Componentes y contratos compartidos
left to right direction
package "Capacidades compartidas" {
  component "Autenticación y autorización" as Security
  component "Validación y errores HTTP" as Validation
  component "Búsqueda y paginación" as Search
  component "Auditoría" as Audit
  component "Notificaciones" as Notify
  component "Reportería" as Reports
  component "Operaciones de catálogo" as Catalog
}
interface "Identidad autenticada" as Identity
interface "AuditTrail" as AuditPort
interface "NotificationPublisher" as NotifyPort
interface "Consultas de lectura" as QueryPort
package "Módulos consumidores" {
  component "Gestión maestra" as Masters
  component "Compras" as Purchases
  component "Inventario" as Inventory
  component "Ventas" as Sales
  component "Contabilidad" as Finance
  component "Recursos humanos" as HR
}
Security ..|> Identity
Audit ..|> AuditPort
Notify ..|> NotifyPort
Masters ..> Identity
Purchases ..> Identity
Inventory ..> Identity
Sales ..> Identity
Masters ..> AuditPort
Purchases ..> AuditPort
Inventory ..> AuditPort
Sales ..> AuditPort
Finance ..> AuditPort
HR ..> AuditPort
Masters ..> Search
Purchases ..> Search
Inventory ..> Search
Sales ..> Search
Masters ..> Catalog
Purchases ..> NotifyPort
Inventory ..> NotifyPort
Sales ..> NotifyPort
Reports ..> QueryPort
Reports ..> Security : permisos
Validation ..> Security : registro de denegación
note bottom of Notify
  La publicación se realiza después del commit.
  El canal APP no garantiza entrega ante caída del proceso.
end note
note bottom of Reports
  Cada consulta utiliza fuentes y fórmulas verificadas.
  Un dato no disponible no se presenta como cero.
end note
@enduml
