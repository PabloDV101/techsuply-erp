@startuml TechSupply_Component_Overview
!include ../_estilo.iuml
title TechSupply Solutions — Componentes principales
left to right direction
actor "Usuario interno" as Employee
actor "Cliente" as Customer
package "Presentación" {
  component "Aplicación web\nReact / TypeScript" as Web
}
package "Backend modular" {
  component "API REST\nDTO y validación" as API
  component "Seguridad" as Security
  component "Gestión maestra" as Masters
  component "Compras" as Purchases
  component "Inventario" as Inventory
  component "Ventas" as Sales
  component "Contabilidad" as Finance
  component "Recursos humanos" as HR
  component "Auditoría" as Audit
  component "Notificaciones" as Notify
  component "Reportería" as Reports
  component "Persistencia JPA" as Persistence
}
database "PostgreSQL" as DB
Employee -- Web
Customer -- Web
Web ..> API : REST / JSON
API ..> Security : autentica y autoriza
API ..> Masters
API ..> Purchases
API ..> Inventory
API ..> Sales
API ..> Finance
API ..> HR
API ..> Reports
Purchases ..> Inventory : recepción
Sales ..> Inventory : reserva y despacho
Purchases ..> Finance
Sales ..> Finance
HR ..> Finance
Masters ..> Audit
Purchases ..> Audit
Inventory ..> Audit
Sales ..> Audit
Sales ..> Notify
Masters ..> Persistence
Purchases ..> Persistence
Inventory ..> Persistence
Sales ..> Persistence
Finance ..> Persistence
HR ..> Persistence
Reports ..> Persistence
Persistence ..> DB
@enduml
