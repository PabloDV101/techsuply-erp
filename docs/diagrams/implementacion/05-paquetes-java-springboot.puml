@startuml TechSupply_Java_Package_Overview
!include ../_estilo.iuml
title TechSupply Solutions — Organización real del backend
caption VISTA MIXTA · Azul: implementado; gris: diseño objetivo; las notas delimitan las integraciones pendientes.
top to bottom direction
package "erp-backend/src/main/java/com/techsupply/erp_backend" {
  component "ErpBackendApplication" as Main <<implementado>>
  package "common.api" as CommonApi {
    component "ApiError / GlobalApiExceptionHandler\nPageRequests / PageResponse" as GlobalErrors <<implementado>>
  }
  package "security" {
    package "api" as API {
      component "AuthController\nAdminUsuariosController\nAuthErrorWriter / AuthExceptionHandler" as ApiClasses <<implementado>>
    }
    package "application" as App {
      component "AuthService / UserManagementService\nAuthenticatedActor / AuthenticatedUserProvider\ndto / validation" as AppClasses <<implementado>>
    }
    package "domain.model" as Domain {
      component "Usuario / Rol / Permiso / TokenSesion" as Models <<implementado>>
    }
    package "infrastructure.persistence" as Persistence {
      component "UsuarioRepository / RolRepository\nPermisoRepository / TokenSesionRepository" as Repos <<implementado>>
    }
    package "infrastructure.security" as Security {
      component "OpaqueBearerAuthenticationFilter / OpaqueTokenService\nSecurityActor / SecurityContextAuthenticatedUserProvider" as SecurityClasses <<implementado>>
    }
    package "config" {
      component "SecurityConfig / SecurityClockConfig\nAdminBootstrapRunner" as Config <<implementado>>
    }
  }
  package "maestros" {
    component "CategoriaProductoController / Service\nDTO / Entity / Repository / Specifications" as Categories <<implementado>>
  }
  package "audit" {
    component "AuditController / AuditTrail / AuditQueryService\nAuditEvent / AuditEventRepository" as AuditModule <<implementado>>
  }
  package "notifications" {
    component "NotificationController / NotificationPublisher\nInboxService / InternalNotification / Writer" as NotificationModule <<implementado>>
  }
  package "Paquetes de negocio previstos · aún no existen" {
    component "resto de maestros / compras / inventario / ventas\ncontabilidad / rrhh / reportería / productores de avisos" as Future <<objetivo>>
  }
}
package "src/main/resources" {
  artifact "application.yaml\nspring.jpa.hibernate.ddl-auto: validate" as Settings
  package "db/migration" {
    artifact "V1__security_schema.sql" as V1
    artifact "V2__security_catalogs.sql" as V2
    artifact "V3__product_categories.sql" as V3
    artifact "V4__audit_events.sql" as V4
    artifact "V5__internal_notifications.sql" as V5
  }
}
package "src/test/java/com/techsupply/erp_backend" {
  artifact "AuthServiceTest / PasswordValidationTest\nOpaqueTokenServiceTest / AuthOpenApiContractTest" as Unit
  artifact "GlobalApiExceptionHandlerTest\nMockMvc aislado" as ValidationTest <<implementado>>
  artifact "AuthIntegrationIT / ErpBackendApplicationIT\nPostgresIntegrationSupport" as Integration
  artifact "CategoriaProductoIntegrationIT" as CategoryIT <<implementado>>
  artifact "AuditIntegrationIT" as AuditIT <<implementado>>
  artifact "NotificationRequestTest / NotificationOpenApiContractTest\nNotificationIntegrationIT" as NotificationIT <<implementado>>
}
Main ..> Config
ApiClasses ..> AppClasses
ApiClasses ..> GlobalErrors : fallback HTTP (menor prioridad)
ValidationTest ..> GlobalErrors
Categories ..> GlobalErrors : paginación / errores
CategoryIT ..> V3
AuditIT ..> V4
AuditModule ..> V4
NotificationModule ..> V5
NotificationIT ..> V5
Categories ..> AuditModule : cambios relevantes
AppClasses ..> AuditModule : seguridad
AppClasses ..> Models
AppClasses ..> Repos
SecurityClasses ..> Repos
note bottom of V5
  Flyway ejecuta V1, V2, V3, V4 y V5 en orden de versión.
  El orden de ejecución no es una asociación estructural UML.
end note
Integration ..> V1
Unit ..> AppClasses
note bottom of V2
  Solo catálogos; no crea cuentas ni contraseñas.
  El administrador se crea con bootstrap explícito.
  Flyway se ejecuta al arrancar; no hay job de release separado actual.
end note
@enduml
