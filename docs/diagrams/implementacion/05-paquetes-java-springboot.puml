@startuml TechSupply_Java_Package_Overview
!include ../_estilo.iuml
title TechSupply Solutions — Organización real del backend
caption VISTA MIXTA · Azul: implementado; gris: diseño objetivo; las notas delimitan las integraciones pendientes.
top to bottom direction
package "erp-backend/src/main/java/com/techsupply/erp_backend" {
  component "ErpBackendApplication" as Main <<implementado>>
  package "common.api" as CommonApi {
    component "ApiError / GlobalApiExceptionHandler\nPageRequests / PageResponse" as GlobalErrors <<implementado>>
  }
  package "security" {
    package "api" as API {
      component "AuthController\nAdminUsuariosController\nAuthErrorWriter / AuthExceptionHandler" as ApiClasses <<implementado>>
    }
    package "application" as App {
      component "AuthService / UserManagementService\nAuthenticatedActor / AuthenticatedUserProvider\ndto / validation" as AppClasses <<implementado>>
    }
    package "domain.model" as Domain {
      component "Usuario / Rol / Permiso / TokenSesion" as Models <<implementado>>
    }
    package "infrastructure.persistence" as Persistence {
      component "UsuarioRepository / RolRepository\nPermisoRepository / TokenSesionRepository" as Repos <<implementado>>
    }
    package "infrastructure.security" as Security {
      component "OpaqueBearerAuthenticationFilter / OpaqueTokenService\nSecurityActor / SecurityContextAuthenticatedUserProvider" as SecurityClasses <<implementado>>
    }
    package "config" {
      component "SecurityConfig / SecurityClockConfig\nAdminBootstrapRunner" as Config <<implementado>>
    }
  }
  package "maestros" {
    component "CategoriaProductoController / Service\nDTO / Entity / Repository / Specifications" as Categories <<implementado>>
    component "Departamento / Proveedor / Almacen\nController / Service / DTO / Entity / Repository\nCatalogoParaCompras" as MasterCatalogs <<implementado>>
    component "Producto\nController / Service / DTO / Entity / Repository" as MasterPersistence <<implementado>>
  }
  package "audit" {
    component "AuditController / AuditTrail / AuditQueryService\nAuditEvent / AuditEventRepository" as AuditModule <<implementado>>
  }
  package "compras" {
    component "OrdenCompra / DetalleOrdenCompra\nEstadoOrdenCompra / CalculoOrden / repositorios" as PurchaseDomain <<implementado>>
    component "OrdenCompraController / OrdenCompraService\nDTO / validación" as PurchaseApi <<implementado>>
    component "RecepcionCompraController / Service\nRecepcionCompra / DetalleRecepcion / DTO / repositorios" as ReceiptApi <<implementado>>
  }
  package "inventario" {
    component "ExistenciaController / InventarioService\nExistencia / MovimientoInventario / ValoracionInventario\nrepositorios / DTO" as Inventory <<implementado>>
  }
  package "notifications" {
    component "NotificationController / NotificationPublisher\nInboxService / InternalNotification / Writer" as NotificationModule <<implementado>>
  }
  package "Paquetes de negocio previstos · aún no existen" {
    component "ventas / contabilidad / rrhh\nreportería / productores de avisos" as Future <<objetivo>>
  }
}
package "src/main/resources" {
  artifact "application.yaml\nspring.jpa.hibernate.ddl-auto: validate" as Settings
  package "db/migration" {
    artifact "V1__security_schema.sql" as V1
    artifact "V2__security_catalogs.sql" as V2
    artifact "V3__product_categories.sql" as V3
    artifact "V4__audit_events.sql" as V4
    artifact "V5__internal_notifications.sql" as V5
    artifact "V6__master_purchase_catalogs.sql" as V6
    artifact "V7__purchase_receipt_inventory_core.sql" as V7
  }
}
package "src/test/java/com/techsupply/erp_backend" {
  artifact "AuthServiceTest / PasswordValidationTest\nOpaqueTokenServiceTest / AuthOpenApiContractTest" as Unit
  artifact "GlobalApiExceptionHandlerTest\nMockMvc aislado" as ValidationTest <<implementado>>
  artifact "AuthIntegrationIT / ErpBackendApplicationIT\nPostgresIntegrationSupport" as Integration
  artifact "CategoriaProductoIntegrationIT" as CategoryIT <<implementado>>
  artifact "AuditIntegrationIT" as AuditIT <<implementado>>
  artifact "NotificationRequestTest / NotificationOpenApiContractTest\nNotificationIntegrationIT" as NotificationIT <<implementado>>
  artifact "MasterCatalogMigrationIT" as CatalogMigrationIT <<implementado>>
  artifact "MasterCatalogPersistenceIT" as CatalogPersistenceIT <<implementado>>
  artifact "MasterCatalogApiIT / MasterCatalogOpenApiContractTest" as CatalogApiIT <<implementado>>
  artifact "PurchaseCoreMigrationIT" as PurchaseMigrationIT <<implementado>>
  artifact "CalculoOrdenTest / OrdenCompraPersistenceIT" as PurchaseTests <<implementado>>
  artifact "OrdenCompraApiIT / OrdenCompraOpenApiContractTest" as PurchaseApiTests <<implementado>>
  artifact "ValoracionInventarioTest / InventarioIntegrationIT\nInventarioOpenApiContractTest" as InventoryTests <<implementado>>
  artifact "RecepcionCompraApiIT / RecepcionCompraOpenApiContractTest" as ReceiptTests <<implementado>>
  artifact "ConfirmarRecepcionIT" as ConfirmationTests <<implementado>>
}
Main ..> Config
ApiClasses ..> AppClasses
ApiClasses ..> GlobalErrors : fallback HTTP (menor prioridad)
ValidationTest ..> GlobalErrors
Categories ..> GlobalErrors : paginación / errores
CategoryIT ..> V3
AuditIT ..> V4
AuditModule ..> V4
NotificationModule ..> V5
NotificationIT ..> V5
CatalogMigrationIT ..> V6
PurchaseMigrationIT ..> V7
PurchaseDomain ..> V7 : mapeo JPA
PurchaseTests ..> PurchaseDomain
PurchaseApi ..> PurchaseDomain
PurchaseApi ..> MasterCatalogs : catálogo para compras
PurchaseApi ..> MasterPersistence : productos
PurchaseApi ..> AuditModule : auditoría
PurchaseApi ..> GlobalErrors : paginación / errores
PurchaseApiTests ..> PurchaseApi
ReceiptApi ..> PurchaseDomain : orden y líneas
ReceiptApi ..> MasterCatalogs : almacén activo
ReceiptApi ..> AuditModule : auditoría
ReceiptApi ..> V7 : JPA y secuencia
ReceiptTests ..> ReceiptApi
ReceiptApi ..> Inventory : entrada transaccional
ConfirmationTests ..> ReceiptApi
Inventory ..> V7 : JPA / SQL transaccional
Inventory ..> GlobalErrors : paginación / errores
InventoryTests ..> Inventory
CatalogPersistenceIT ..> MasterPersistence
CatalogPersistenceIT ..> V6
MasterPersistence ..> V6 : mapeo JPA
MasterCatalogs ..> V6 : mapeo JPA
MasterCatalogs ..> AuditModule : cambios
MasterCatalogs ..> GlobalErrors : paginación / errores
CatalogApiIT ..> MasterCatalogs
MasterPersistence ..> Categories : categoria V3
Categories ..> AuditModule : cambios relevantes
AppClasses ..> AuditModule : seguridad
AppClasses ..> Models
AppClasses ..> Repos
SecurityClasses ..> Repos
note bottom of V6
  Flyway ejecuta V1–V7 en orden de versión.
  V6 crea cuatro tablas y permisos. Los cuatro catálogos tienen API.
  El orden de ejecución no es una asociación estructural UML.
end note
note bottom of V7
  SQL parcial de compras e inventario; entidades de orden implementadas,
  Órdenes, recepción y consulta de existencias implementadas;
  fuentes adicionales de inventario permanecen pendientes.
  El modelo objetivo incluye fuentes adicionales aún no creadas.
end note
Integration ..> V1
Unit ..> AppClasses
note bottom of V2
  Solo catálogos; no crea cuentas ni contraseñas.
  El administrador se crea con bootstrap explícito.
  Flyway se ejecuta al arrancar; no hay job de release separado actual.
end note
@enduml
