@startuml CU_Seguridad
!include ../_estilo.iuml
title TechSupply Solutions — Seguridad
left to right direction

actor "Usuario del ERP" as Usuario
actor "Administrador del sistema" as Admin
actor "Auditor" as Auditor

rectangle "ERP - Seguridad" {
  usecase "Iniciar sesión" as Login
  usecase "Cerrar sesión" as Logout
  usecase "Validar credenciales" as Credenciales
  usecase "Consultar perfil propio" as Perfil
  usecase "Gestionar usuarios" as GestionUsuarios
  usecase "Activar y desactivar cuentas" as EstadoCuenta
  usecase "Crear y consultar permisos" as CatalogoPermisos
  usecase "Gestionar roles" as Roles
  usecase "Asignar permisos por módulo" as AsignarPermisos
  usecase "Consultar registros de auditoría" as ConsultarAuditoria
}


Usuario -- Login
Usuario -- Logout
Usuario -- Perfil

Admin -- GestionUsuarios
Admin -- EstadoCuenta
Admin -- CatalogoPermisos
Admin -- Roles
Admin -- AsignarPermisos
Admin -- ConsultarAuditoria

Auditor -- ConsultarAuditoria

Login ..> Credenciales : <<include>>

note bottom of GestionUsuarios
  Los administradores solo pueden delegar permisos
  que poseen y sus acciones quedan auditadas.
end note

note bottom of ConsultarAuditoria
  La consulta requiere autorización y protege
  los datos sensibles del registro.
end note

@enduml
