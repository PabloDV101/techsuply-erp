@startuml CU_Gestion_Maestra
!include ../_estilo.iuml
caption VISTA MIXTA · Gestión de categorías implementada; productos y demás catálogos pendientes.
title TechSupply Solutions — Gestion maestra
left to right direction

actor "Responsable de compras" as Compras
actor "Responsable de ventas" as Ventas
actor "Responsable de almacén" as Almacen
actor "Responsable de RR. HH." as RRHH
actor "Administrador del sistema" as Admin

rectangle "ERP - Gestión Maestra" {
  usecase "Gestionar categorías\nde producto" as Categorias <<implementado>>
  usecase "Gestionar productos" as Productos
  usecase "Consultar productos" as ConsultarProductos
  usecase "Clasificar productos" as ClasificarProductos
  usecase "Gestionar proveedores" as Proveedores
  usecase "Consultar historial de proveedores" as HistorialProveedores
  usecase "Gestionar clientes" as Clientes
  usecase "Consultar historial de clientes" as HistorialClientes
  usecase "Gestionar empleados" as Empleados
  usecase "Gestionar departamentos y puestos" as Departamentos
  usecase "Gestionar almacenes" as Almacenes
  usecase "Consultar catálogos" as Catalogos
}

Compras -- Proveedores
Compras -- HistorialProveedores
Compras -- Productos

Ventas -- Clientes
Ventas -- HistorialClientes
Ventas -- ConsultarProductos

Almacen -- Productos
Almacen -- Almacenes
Almacen -- ClasificarProductos

RRHH -- Empleados
RRHH -- Departamentos

Admin -- Productos
Admin -- Categorias
Admin -- Proveedores
Admin -- Clientes
Admin -- Empleados
Admin -- Almacenes

ConsultarProductos ..> Catalogos : <<include>>
ClasificarProductos ..> Productos : <<extend>>

note bottom of HistorialProveedores
  Los historiales consultan registros existentes.
  No requieren ejecutar el mantenimiento del catálogo.
end note
note right of Categorias
  API actual: crear, consultar, listar con paginación,
  actualizar y activar/desactivar. Requiere permisos
  MAESTROS_CATEGORIAS_LEER o MAESTROS_CATEGORIAS_ADMIN.
  No hay borrado físico ni productos implementados.
end note
@enduml
