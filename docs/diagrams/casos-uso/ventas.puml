@startuml CU_Ventas
!include ../_estilo.iuml
title TechSupply Solutions — Casos de uso de Ventas
left to right direction
actor "Responsable de ventas" as Vendedor
actor "Cliente" as Cliente
actor "Responsable de almacén" as Almacen
actor "Contador" as Contador
rectangle "ERP · Ventas" {
  usecase "Consultar catálogo\ny precios" as Catalogo
  usecase "Gestionar clientes" as Clientes
  usecase "Gestionar cotizaciones" as Cotizaciones
  usecase "Gestionar pedidos" as Pedidos
  usecase "Consultar estado\ndel pedido" as Estado
  usecase "Gestionar despachos" as Despachos
  usecase "Registrar devolución" as Devolucion
  usecase "Emitir factura comercial" as Factura
}
Cliente -- Catalogo
Cliente -- Cotizaciones
Cliente -- Pedidos
Cliente -- Estado
Vendedor -- Catalogo
Vendedor -- Clientes
Vendedor -- Cotizaciones
Vendedor -- Pedidos
Vendedor -- Estado
Vendedor -- Factura
Vendedor -- Devolucion
Almacen -- Despachos
