@startuml CU_Inventario
!include ../_estilo.iuml
caption VISTA MIXTA · Conteos, ajustes y alerta global implementados; salidas de ventas pendientes.
title TechSupply Solutions — Inventario
left to right direction

actor "Responsable de almacén" as Almacen
actor "Responsable de compras" as Compras
actor "Responsable de ventas" as Ventas
actor "Auditor" as Auditor
actor "Aprobador autorizado" as Aprobador
actor "Aplicador autorizado" as Aplicador

rectangle "ERP - Gestión de Inventario" {
  usecase "Consultar existencias" as Existencias <<implementado>>
  usecase "Registrar entrada de productos" as Entrada
  usecase "Registrar salida de productos" as Salida
  usecase "Registrar otros movimientos" as Movimientos
  usecase "Realizar conteo físico" as Conteo <<implementado>>
  usecase "Comparar stock físico y registrado" as Comparar <<implementado>>
  usecase "Solicitar ajuste de inventario" as SolicitarAjuste <<implementado>>
  usecase "Autorizar ajuste" as AutorizarAjuste <<implementado>>
  usecase "Aplicar ajuste aprobado" as AplicarAjuste <<implementado>>
  usecase "Consultar historial de movimientos" as Historial <<implementado>>
  usecase "Consultar alertas globales de stock mínimo" as Alertas <<implementado>>
  usecase "Consultar rotación de productos" as Rotacion
  usecase "Consultar productos obsoletos" as Obsoletos
}


Almacen -- Existencias
Almacen -- Entrada
Almacen -- Salida
Almacen -- Movimientos
Almacen -- Conteo
Almacen -- SolicitarAjuste
Almacen -- Alertas
Almacen -- Historial

Compras -- Existencias
Compras -- Alertas

Ventas -- Existencias

Auditor -- Historial
Aprobador -- AutorizarAjuste
Aplicador -- AplicarAjuste
Almacen -- Rotacion
Almacen -- Obsoletos

Conteo ..> Comparar : <<include>>

note bottom of AutorizarAjuste
  Precondición: solicitud pendiente y actor autorizado distinto del solicitante.
  Aprobar/rechazar no aplica el ajuste ni modifica existencias.
end note
note bottom of AplicarAjuste
  Requiere permiso de aplicación; afecta stock y kardex atómicamente.
end note
note bottom of Alertas
  Consulta calculada; no genera órdenes ni notificaciones.
end note
note bottom of Existencias
  El almacén es un criterio de consulta, no una extensión
  opcional de otro caso de uso.
end note
@enduml
