
@startuml CU_Inventario
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Responsable de almacén" as Almacen
actor "Responsable de compras" as Compras
actor "Responsable de ventas" as Ventas
actor "Auditor" as Auditor

rectangle "ERP - Gestión de Inventario" {
  usecase "Consultar existencias" as Existencias
  usecase "Consultar existencias por almacén" as PorAlmacen
  usecase "Registrar entrada de productos" as Entrada
  usecase "Registrar salida de productos" as Salida
  usecase "Registrar otros movimientos" as Movimientos
  usecase "Realizar conteo físico" as Conteo
  usecase "Comparar stock físico y registrado" as Comparar
  usecase "Solicitar ajuste de inventario" as SolicitarAjuste
  usecase "Autorizar ajuste" as AutorizarAjuste
  usecase "Consultar historial de movimientos" as Historial
  usecase "Generar alertas de stock mínimo" as Alertas
  usecase "Consultar rotación de productos" as Rotacion
  usecase "Consultar productos obsoletos" as Obsoletos
}


Almacen --> Existencias
Almacen --> Entrada
Almacen --> Salida
Almacen --> Movimientos
Almacen --> Conteo
Almacen --> SolicitarAjuste
Almacen --> Alertas
Almacen --> Historial

Compras --> Existencias
Compras --> Alertas

Ventas --> Existencias

Auditor --> Historial

PorAlmacen ..> Existencias : <<extend>>
Conteo ..> Comparar : <<include>>
SolicitarAjuste ..> Comparar : <<include>>
AutorizarAjuste ..> SolicitarAjuste : <<extend>>
Entrada ..> Historial : <<include>>
Salida ..> Historial : <<include>>
Movimientos ..> Historial : <<include>>

@enduml
