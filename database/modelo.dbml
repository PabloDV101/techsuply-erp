Ref: pagos_nomina.registrado_por_usuario_id > usuarios.id

// Reportería y servicios transversales
Ref: ejecuciones_reporte.definicion_reporte_id > definiciones_reporte.id
Ref: ejecuciones_reporte.usuario_id > usuarios.id
Ref: notificaciones.usuario_id > usuarios.id
Ref: parametros_sistema.actualizado_por_usuario_id > usuarios.id
Ref: valores_indicador.indicador_id > indicadores.id

