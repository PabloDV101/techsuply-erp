Ref: despachos.pedido_id > pedidos_venta.id
Ref: despachos.almacen_id > almacenes.id
Ref: despachos.registrado_por_usuario_id > usuarios.id
Ref: detalles_despacho.despacho_id > despachos.id
Ref: detalles_despacho.detalle_pedido_id > detalles_pedido.id
Ref: facturas_venta.pedido_id > pedidos_venta.id
Ref: facturas_venta.cliente_id > clientes.id
Ref: detalles_factura_venta.factura_venta_id > facturas_venta.id
Ref: detalles_factura_venta.detalle_pedido_id > detalles_pedido.id
Ref: detalles_factura_venta.producto_id > productos.id
Ref: cobros_clientes.cliente_id > clientes.id
Ref: cobros_clientes.registrado_por_usuario_id > usuarios.id
Ref: pagos_proveedor.proveedor_id > proveedores.id
Ref: pagos_proveedor.registrado_por_usuario_id > usuarios.id
Ref: devoluciones_cliente.pedido_id > pedidos_venta.id
Ref: devoluciones_cliente.cliente_id > clientes.id
Ref: devoluciones_cliente.almacen_id > almacenes.id
Ref: devoluciones_cliente.registrada_por_usuario_id > usuarios.id
Ref: devoluciones_cliente.autorizada_por_usuario_id > usuarios.id
Ref: detalles_devolucion_cliente.devolucion_cliente_id > devoluciones_cliente.id
Ref: detalles_devolucion_cliente.detalle_pedido_id > detalles_pedido.id

// Contabilidad
Ref: cuentas_contables.cuenta_padre_id > cuentas_contables.id
Ref: periodos_contables.cerrado_por_usuario_id > usuarios.id
