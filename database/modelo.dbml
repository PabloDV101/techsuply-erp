Ref: movimientos_inventario.detalle_devolucion_proveedor_id > detalles_devolucion_proveedor.id
Ref: movimientos_inventario.detalle_devolucion_cliente_id > detalles_devolucion_cliente.id
Ref: movimientos_inventario.detalle_pedido_id > detalles_pedido.id
Ref: movimientos_inventario.movimiento_reversado_de_id > movimientos_inventario.id
Ref: conteos_inventario.almacen_id > almacenes.id
Ref: conteos_inventario.creado_por_usuario_id > usuarios.id
Ref: detalles_conteo.conteo_id > conteos_inventario.id
Ref: detalles_conteo.producto_id > productos.id
Ref: ajustes_inventario.almacen_id > almacenes.id
Ref: detalles_ajuste_inventario.detalle_conteo_id > detalles_conteo.id
Ref: ajustes_inventario.solicitado_por_usuario_id > usuarios.id
Ref: ajustes_inventario.autorizado_por_usuario_id > usuarios.id
Ref: detalles_ajuste_inventario.ajuste_inventario_id > ajustes_inventario.id
Ref: detalles_ajuste_inventario.producto_id > productos.id
Ref: alertas_inventario.producto_id > productos.id
Ref: alertas_inventario.almacen_id > almacenes.id

// Ventas
Ref: cotizaciones.cliente_id > clientes.id
