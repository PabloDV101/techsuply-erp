Ref: aplicaciones_pago_proveedor.cuenta_por_pagar_id > cuentas_por_pagar.id
Ref: presupuestos.departamento_id > departamentos.id
Ref: presupuestos.cuenta_contable_id > cuentas_contables.id

// Recursos humanos y nómina
Ref: expedientes_laborales.empleado_id > empleados.id
Ref: expedientes_laborales.departamento_id > departamentos.id
Ref: expedientes_laborales.puesto_id > puestos.id
Ref: registros_asistencia.empleado_id > empleados.id
Ref: registros_asistencia.registrado_por_usuario_id > usuarios.id
Ref: solicitudes_vacaciones.empleado_id > empleados.id
Ref: solicitudes_vacaciones.resuelta_por_usuario_id > usuarios.id
Ref: nominas.periodo_nomina_id > periodos_nomina.id
Ref: nominas.calculado_por_usuario_id > usuarios.id
Ref: nominas.aprobado_por_usuario_id > usuarios.id
Ref: detalles_nomina.nomina_id > nominas.id
Ref: detalles_nomina.empleado_id > empleados.id
Ref: detalles_nomina.departamento_id > departamentos.id
Ref: detalles_nomina.expediente_laboral_id > expedientes_laborales.id
